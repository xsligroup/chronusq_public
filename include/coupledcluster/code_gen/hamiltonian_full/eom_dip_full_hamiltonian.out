    // H_oooo += -1.000000 d(i,k) f(l,a) t1(a,j) 
    // flops: o4v0: 1 | mem: o4v0: 1, 
    H_oooo("i,j,k,l") -= tempOps["oooo_58"]("l,j,i,k");
    tempOps["oooo_58"] = TArrayD();

    // tempOps["oooo_59"] += 1.000000 d_oo("i,k") f_oo("l,j") 
    // flops: o4v0: 2 | mem: o4v0: 2, 
    tempOps["oooo_59"]("i,k,l,j") = d_oo("i,k") * f_oo("l,j");

    // H_oooo += -1.000000 d(j,l) f(k,i) 
    // flops: o4v0: 1 | mem: o4v0: 1, 
    H_oooo("i,j,k,l") -= tempOps["oooo_59"]("j,l,k,i");

    // H_oooo += -1.000000 d(i,k) f(l,j) 
    // flops: o4v0: 1 | mem: o4v0: 1, 
    H_oooo("i,j,k,l") -= tempOps["oooo_59"]("i,k,l,j");

    // H_oooo += 1.000000 d(j,k) f(l,i) 
    // flops: o4v0: 1 | mem: o4v0: 1, 
    H_oooo("i,j,k,l") += tempOps["oooo_59"]("j,k,l,i");

    // H_oooo += 1.000000 d(i,l) f(k,j) 
    // flops: o4v0: 1 | mem: o4v0: 1, 
    H_oooo("i,j,k,l") += tempOps["oooo_59"]("i,l,k,j");
    tempOps["oooo_59"] = TArrayD();

    // H_oooo += -1.000000 <k,l||a,b> t1(a,j) t1(b,i) 
    // flops: o3v2: 1, o4v1: 1, o4v0: 1 | mem: o3v1: 1, o4v0: 2, 
    H_oooo("i,j,k,l") -= eri_oovv("k,l,a,b") * t1_vo("a,j") * t1_vo("b,i");

    // H_oooo += 1.000000 <k,l||i,j> 
    // flops: o4v0: 1 | mem: o4v0: 1, 
    H_oooo("i,j,k,l") += eri_oooo("k,l,i,j");

    // H_oooo += 1.000000 P(i,j) <k,l||a,j> t1(a,i) 
    // flops: o4v1: 1, o4v0: 2 | mem: o4v0: 2, 
    tempPerm_oooo("i,j,k,l") = eri_oovo("k,l,a,j") * t1_vo("a,i");
    H_oooo("i,j,k,l") += tempPerm_oooo("i,j,k,l");
    H_oooo("i,j,k,l") -= tempPerm_oooo("j,i,k,l");
}


