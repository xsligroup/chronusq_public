# O2 U-LRC-wPBE/cc-pVDZ with direct full-Coulomb J/K and a separate
# Libint-direct short-range exchange correction.
[Molecule]
charge = 0
mult = 3
geom:
 O  0.0  0.0  0.0
 O  1.2  0.0  0.0

[QM]
reference = Real ULRCWPBE
job = SCF

[SCF]
accuracy = 1e-10
maxiter = 100

[DFTINT]
inhouse = false
nrad = 99
nang = 590

[GAUXC]
grid = ultrafine
pruningscheme = unpruned
radialquad = murrayhandylaming
xcweightalg = becke

[INTS]
alg = direct

[BASIS]
basis = cc-pvdz

[MISC]
nsmp = 1
mem = 256 MB
