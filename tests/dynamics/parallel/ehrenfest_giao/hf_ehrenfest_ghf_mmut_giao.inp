[Molecule]
charge = 0
mult = 1
geom:
 H   0.60  0.0  0.0
 F  -0.60  0.0  0.0

#
#  Job Specification
#
[QM]
reference = complex GHF
job = Ehrenfest

[SCF]
#GUESS = READMO
#QP_GUESS = TIGHT
PRINTMOS = 0
EXTRAP = TRUE
MAXITER = 5000
DIISALG = CDIIS
accuracy = 1e-12
field = Magnetic 0.0 0.0 0.05

[DYNAMICS]
TMAX   = 20.
DELTAT = 2.
NNUCPGRAD = 10
NELECPNUC = 10
SAVEALLGEOMETRY = true

[RT]
INTALG = MMUT

[MISC]
nsmp = 2
mem = os

[INTS]
ALG = incore

[BASIS]
basis = sto-3g
basistype = GIAO


[PHYSCON]
LEGACY_CONSTANTS = TRUE
