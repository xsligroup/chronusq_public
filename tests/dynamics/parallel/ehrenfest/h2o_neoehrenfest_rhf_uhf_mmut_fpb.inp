# 
#  Job Specification
#  NEO-DFT Ehrenfest from optimized geometry
#
[Molecule]
charge = 0
mult = 1
geom:
 O   0.000000   -0.030189    0.000000
 H   0.740102    0.578634    0.000000 QP
 H  -0.740102    0.578634    0.000000 QP 

[QM]
reference = complex RHF
job = Ehrenfest

[QPQM]
reference = complex UHF

[SCF]
NEO = TRUE
GUESS = Classical
QP_GUESS = TIGHT
PRINTMOS = 0
EXTRAP = TRUE
MAXITER = 5000
DIISALG = CDIIS
Accuracy = 1e-12

[DYNAMICS]
TMAX   = 10
DELTAT = 2
NNUCPGRAD = 10
NELECPNUC = 10
TPB = False

[RT]
INTALG = mmut
RESTARTSTEP = magnus2
PRINTLEVEL = 1

[MISC]
nsmp = 2
mem = os

[INTS]
ALG = direct

[QPINTS]
ALG = direct

[EQPINTS]
ALG = direct

[BASIS]
basis = sto-3g

[QPBASIS]
basis = prot-sp


[PHYSCON]
LEGACY_CONSTANTS = TRUE
