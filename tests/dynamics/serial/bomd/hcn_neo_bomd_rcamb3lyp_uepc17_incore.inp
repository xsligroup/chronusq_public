# HCN NEO R-CAM-B3LYP/cc-pVDZ + U-EPC17/prot-pb4-d RSH BOMD with incore
# electronic integrals. Identical to the direct-algorithm test except for
# the electronic integral representation; shares its reference bin so the
# incore and direct erfc-K paths are checked for consistency.
[Molecule]
charge = 0
mult = 1
geom:
 N  0.00000  0.000000  0.000000
 C  1.15824  0.000000  0.000000
 H  2.22844  0.000000  0.000100 Q

[QM]
reference = Real RCAMB3LYP
job = BOMD

[PROTQM]
reference = Real UEPC17

[SCF]
neo = true
guess = classical
prot_guess = tight
accuracy = 1e-11
maxiter = 512

[DYNAMICS]
tmax = 5
deltat = 1

[DFTINT]
inhouse = false
nrad = 99
nang = 590

[GAUXC]
grid = ultrafine
pruningscheme = unpruned
radialquad = murrayhandylaming
xcweightalg = becke

[BASIS]
basis = cc-pvdz

[PBASIS]
basis = prot-pb4-d

[INTS]
alg = incore
gradalg = incore

[PINTS]
alg = incore
gradalg = direct

[EPINTS]
alg = incore
gradalg = direct

[MISC]
nsmp = 1
mem = 512 MB
