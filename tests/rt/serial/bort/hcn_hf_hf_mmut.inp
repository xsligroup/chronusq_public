# 
#  Job Specification
#  BORT NEO-DFT from optimized geometry
#
[Molecule]
charge = 0
mult = 1

geom:
 N 0.0492158067 0.000 0.000
 C 1.2046693425 0.000 0.000
 H 2.1221148508 0.000 0.000 Q

[QM]
reference = Complex HF
job = RT

[PROTQM]
reference = Complex UHF

[SCF]
NEO = TRUE
guess = classical
prot_guess = tight
MAXITER = 50000
DIISALG = CDIIS
accuracy = 1e-12

[RT]            
INTALG = BORT 
PROT_INTALG = MMUT                                                                  
PRINTLEVEL = 1
BORTPRINTLEVEL = 1
BORTACCURACY = 1E-10  
TMAX = 2.0
DELTAT = 0.1
FIELD:
 StepField(0.,0.00001) Electric 0. 0.001 0.                                                  

[INTS]
ALG = INCORE

[PINTS]
ALG = INCORE

[EPINTS]
ALG = INCORE

[MISC]
nsmp = 1
mem = 5 GB

[BASIS]
basis = sto-3g

[PBASIS]
basis = prot-sp

[PHYSCON]
LEGACY_CONSTANTS = TRUE
