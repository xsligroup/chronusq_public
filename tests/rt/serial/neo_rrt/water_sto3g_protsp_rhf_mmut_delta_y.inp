#
#  test0.05 - Water RHF/STO-3G/PROT-SP : RT
#  SERIAL
chronusq: realtime(stepsize = 0.05au, maxsteps = 20,  mmut, restartalgorithm=magnus2, autosave=1,autorestart=5)
#
#  Molecule Specification 
[Molecule]
charge = 0
mult = 1
geom: 
 O               0  -0.07579184359               0
 H     0.866811829    0.6014357793               0 QP
 H    -0.866811829    0.6014357793               0 QP

# 
#  Job Specification
#
[QM]
reference =complex RHF
job = RT

[QPQM]
reference =complex UHF

[SCF]
NEO = TRUE
guess = classical
qp_guess = tight

[RT]
FIELD:
 StepField(0.,0.0001) Electric 0. 0.001 0.


[BASIS]
basis = sto-3g


[QPBASIS]
basis = prot-sp


[INTS]
ALG = INCORE


[QPINTS]
ALG = INCORE


[EQPINTS]
ALG = INCORE


[MISC]
nsmp = 1
mem  = 100 mb

[PHYSCON]
LEGACY_CONSTANTS = TRUE
